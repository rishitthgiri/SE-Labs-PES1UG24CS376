@startuml Digital_Campus_Library_Reservation_Gateway_UseCaseDiagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Student Member" as Student
actor "Head Librarian" as Librarian

rectangle "Digital Campus Library Reservation Gateway" {
  usecase "Search Catalog\n(by ISBN/Title/Author)" as UC_Search
  usecase "Place Book Reservation/Hold" as UC_Reserve
  usecase "View Queue Position" as UC_ViewQueue
  usecase "Cancel Reservation" as UC_Cancel
  usecase "Send Availability Notification" as UC_Notify
  usecase "Checkout Book" as UC_Checkout
  usecase "Return Book" as UC_Return
  usecase "Calculate Overdue Fine" as UC_Fine
  usecase "Authenticate via Campus SSO" as UC_Auth
  usecase "Manage Catalog\n(Add/Update/Remove Book)" as UC_ManageCatalog
  usecase "Override Reservation Queue" as UC_Override
  usecase "View System Reports" as UC_Reports
}

' Primary actor associations
Student --> UC_Search
Student --> UC_Reserve
Student --> UC_ViewQueue
Student --> UC_Cancel
Student --> UC_Checkout
Student --> UC_Return

Librarian --> UC_ManageCatalog
Librarian --> UC_Checkout
Librarian --> UC_Return
Librarian --> UC_Reports
Librarian --> UC_Override

' Mandatory <<include>> relationship
UC_Reserve .> UC_Auth : <<include>>
UC_Checkout .> UC_Auth : <<include>>
UC_Reserve .> UC_Notify : <<include>>

' Mandatory <<extend>> relationship
UC_Fine .> UC_Return : <<extend>>
UC_Override .> UC_ViewQueue : <<extend>>

note right of UC_Fine
  Extends "Return Book" only
  when return date > due date
  (see FR-005)
end note

note right of UC_Notify
  Included by "Place Book
  Reservation/Hold" once a
  held copy becomes available
  (see FR-004)
end note

@enduml
